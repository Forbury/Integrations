<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 runs the library's netstandard2.0 build, net8.0 and net10.0 its net8.0 build. -->
    <TargetFrameworks>net48;net8.0;net10.0</TargetFrameworks>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageReference Include="NUnit.Analyzers" Version="3.3.0" />
    <PackageReference Include="coverlet.collector" Version="3.1.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Forbury.Integrations\Forbury.Integrations.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.10.0</Version>
    <Authors>Forbury Development Team</Authors>
    <Company>Forbury</Company>
    <PackageDescription>This .NET client library provides a quick and easy option for integrating with Forbury APIs.</PackageDescription>
    <RepositoryUrl>https://github.com/Forbury/Integrations</RepositoryUrl>
    <PackageIcon>logo_128x128.png</PackageIcon>
    <PackageTags>dotnet;fintech;finance;integrations</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>Forbury.Integrations</AssemblyName>
    <PackageId>Forbury.Integrations</PackageId>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENCE.txt</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\LICENCE.txt" Pack="true" PackagePath="" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\..\assets\logo\logo_128x128.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <!-- .NET 8+ gets ASP.NET Core and Microsoft.Extensions from the shared framework, so no 2.x packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.14" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Extensions" Version="2.3.14" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" Version="2.3.14" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <!-- The DTO attributes need it, and Mvc.Core does not bring it in on .NET Framework. -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="API\v1\Dto\Model\Retail\Input\General\" />
    <Folder Include="API\v1\Dto\Model\Retail\Input\Reporting\" />
  </ItemGroup>

</Project>
